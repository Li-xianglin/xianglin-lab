---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../content.config';

interface Props {
	entry: CollectionEntry<'work'>;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/guides/routing/#dynamic-routes
export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<div class="stack gap-20">
		<div class="stack gap-15">
			<header>
				<div class="wrapper stack gap-2">
					<a class="back-link" href="/work/"><Icon icon="arrow-left" /> 返回作品列表</a>
					<Hero title={entry.data.title} align="start">
						<div class="details">
							<div class="tags">
								<Pill>{CATEGORIES[entry.data.category]}</Pill>
								{entry.data.tags.map((t) => <Pill>{t}</Pill>)}
							</div>
							<p class="description">{entry.data.description}</p>
							{(entry.data.role || entry.data.award) && (
								<dl class="meta">
									{entry.data.role && (
										<><dt>角色</dt><dd>{entry.data.role}</dd></>
									)}
									{entry.data.award && (
										<><dt>奖项</dt><dd>{entry.data.award}</dd></>
									)}
								</dl>
							)}
						</div>
					</Hero>
				</div>
			</header>
			<main class="wrapper">
				<div class="stack gap-10 content">
					{!entry.data.gallery && entry.data.img && <img src={entry.data.img} alt={entry.data.img_alt || ''} />}
					<div class="content">
						<Content />
					</div>
					</div>
			</main>

			{entry.data.gallery && entry.data.gallery.length > 0 && (
				<>
					<section class="gallery" aria-label="作品集长图浏览">
						<div class="fs-btn-wrap">
							<button id="fs-toggle" class="fs-btn" aria-label="进入全屏阅读" title="全屏阅读">
								<svg class="fs-icon fs-icon-enter" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
									<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								<svg class="fs-icon fs-icon-exit" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
									<path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</button>
						</div>
						{entry.data.gallery.map((src, i) => (
							<img
								src={src}
								alt={`${entry.data.title} — ${i + 1}`}
								loading={i < 2 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						))}
					</section>
					<script>
						(() => {
							const btn = document.getElementById('fs-toggle');
							if (!btn) return;

							// ===== Fullscreen API =====
							const enter = () => {
								const el = document.documentElement;
								const req =
									el.requestFullscreen ||
									(el as any).webkitRequestFullscreen ||
									(el as any).msRequestFullscreen;
								if (req) req.call(el);
							};
							const exit = () => {
								const doc = document as any;
								const fn =
									doc.exitFullscreen ||
									doc.webkitExitFullscreen ||
									doc.msExitFullscreen;
								if (fn) fn.call(doc);
							};

							btn.addEventListener('click', () => {
								const fsEl =
									document.fullscreenElement ||
									(document as any).webkitFullscreenElement;
								if (fsEl) exit();
								else enter();
							});

							const onChange = () => {
								const fsEl =
									document.fullscreenElement ||
									(document as any).webkitFullscreenElement;
								btn.classList.toggle('is-fs', !!fsEl);
								btn.setAttribute(
									'aria-label',
									fsEl ? '退出全屏' : '进入全屏阅读'
								);
								btn.setAttribute('title', fsEl ? '退出全屏 (Esc)' : '全屏阅读');
							};
							document.addEventListener('fullscreenchange', onChange);
							document.addEventListener('webkitfullscreenchange', onChange);

						})();
					</script>
				</>
			)}
		</div>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	header {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.back-link {
		display: none;
	}

	.details {
		display: flex;
		flex-direction: column;
		padding: 0.5rem;
		gap: 1.5rem;
		justify-content: space-between;
		align-items: center;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
	}

	.description {
		font-size: var(--text-lg);
		max-width: 54ch;
	}

	.content {
		max-width: 72ch;
		margin-inline: auto;
		color: var(--gray-200);
		font-size: var(--text-md);
		line-height: 1.75;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1) {
		font-size: var(--text-3xl);
		font-weight: 600;
		line-height: 1.2;
		color: var(--gray-0);
		margin: 3rem 0 1rem;
	}

	.content :global(h2) {
		font-size: var(--text-xl);
		font-weight: 600;
		line-height: 1.3;
		color: var(--gray-0);
		margin: 3rem 0 0.75rem;
		padding-top: 1rem;
		border-top: 1px solid var(--gray-800);
	}

	.content :global(h2:first-child) {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}

	.content :global(h3) {
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: 1.3;
		color: var(--gray-0);
		margin: 2rem 0 0.5rem;
	}

	.content :global(h4),
	.content :global(h5) {
		font-size: var(--text-md);
		font-weight: 600;
		color: var(--gray-100);
		margin: 1.5rem 0 0.5rem;
	}

	.content :global(p) {
		color: var(--gray-200);
		line-height: 1.75;
		margin: 0;
	}

	.content :global(ul),
	.content :global(ol) {
		padding-left: 1.25rem;
		margin: 0.5rem 0;
	}

	.content :global(li) {
		margin: 0.4rem 0;
		color: var(--gray-200);
		line-height: 1.7;
	}

	.content :global(li strong),
	.content :global(p strong) {
		color: var(--gray-0);
		font-weight: 600;
	}

	.content :global(img) {
		border-radius: 1rem;
		box-shadow: var(--shadow-sm);
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		max-width: 100%;
		height: auto;
	}

	.content :global(blockquote) {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 500;
		line-height: 1.5;
		padding: 1rem 1.25rem;
		border-inline-start: 2px solid var(--gray-400);
		color: var(--gray-100);
		background: rgba(255, 255, 255, 0.02);
		border-radius: 0 0.5rem 0.5rem 0;
		margin: 1.5rem 0;
	}

	.back-link,
	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus,
	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	.meta {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.5rem 1rem;
		margin: 0;
		font-size: var(--text-sm);
	}

	.meta dt {
		color: var(--gray-400);
	}

	.meta dd {
		margin: 0;
		color: var(--gray-100);
	}

	.external-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.25rem;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		text-decoration: none;
		border-radius: 999rem;
		font-size: var(--text-md);
		align-self: flex-start;
		transition: opacity 0.2s ease;
	}

	.external-link:hover {
		opacity: 0.85;
	}

	/* ===== Long-scroll gallery (无缝堆叠的长图浏览) ===== */
	.gallery {
		display: block;
		max-width: 1920px;
		margin: 3rem auto 0;
		padding: 0;
		background: #ffffff;
		/* 让多个切片看起来像一张连续长图：不留间隙、不加圆角 */
	}

	.gallery img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
	}

	@media (min-width: 50em) {
		.gallery {
			margin-top: 4rem;
		}
	}

	/* ===== Fullscreen toggle (sticky to top of viewport while gallery is in view) ===== */
	.fs-btn-wrap {
		position: sticky;
		top: 1.25rem;
		z-index: 10;
		display: flex;
		justify-content: flex-end;
		padding: 0 1.25rem;
		height: 0; /* don't reserve vertical space, button overflows above first image */
		pointer-events: none; /* let clicks pass through except on button */
	}

	.fs-btn {
		pointer-events: auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border-radius: 999rem;
		border: 1px solid rgba(0, 0, 0, 0.15);
		background: rgba(255, 255, 255, 0.85);
		backdrop-filter: saturate(180%) blur(12px);
		-webkit-backdrop-filter: saturate(180%) blur(12px);
		color: #1a1a1a;
		cursor: pointer;
		box-shadow: 0 6px 20px -6px rgba(0, 0, 0, 0.25);
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.fs-btn:hover {
		background: #ffffff;
		border-color: rgba(0, 0, 0, 0.3);
		transform: scale(1.06);
	}

	.fs-btn:focus-visible {
		outline: 2px solid #1a1a1a;
		outline-offset: 2px;
	}

	.fs-btn:focus-visible {
		outline: 2px solid var(--gray-0);
		outline-offset: 2px;
	}

	.fs-icon {
		display: block;
	}

	.fs-icon-exit {
		display: none;
	}

	.fs-btn.is-fs .fs-icon-enter {
		display: none;
	}

	.fs-btn.is-fs .fs-icon-exit {
		display: block;
	}

	@media (min-width: 50em) {
		.fs-btn {
			top: 1.5rem;
			right: 1.5rem;
			width: 2.75rem;
			height: 2.75rem;
		}
	}

	/* In fullscreen mode, hide nav/footer for immersive reading */
	:global(:fullscreen) :global(nav),
	:global(:fullscreen) :global(footer) {
		display: none;
	}

	@media (min-width: 50em) {
		.back-link {
			display: block;
			align-self: flex-start;
		}

		.details {
			flex-direction: row;
			gap: 2.5rem;
			flex-wrap: wrap;
		}

		.content :global(blockquote) {
			font-size: var(--text-2xl);
		}
	}
</style>
