---
import { getCollection } from 'astro:content';
import { CATEGORIES, type CategorySlug } from '../content.config';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const grouped = (Object.keys(CATEGORIES) as CategorySlug[]).map((slug) => ({
	slug,
	label: CATEGORIES[slug],
	projects: all.filter((p) => p.data.category === slug),
}));
---

<BaseLayout
	title="作品 | 李想林"
	description="李想林的作品集 — 后台系统、App 设计、网页设计、可视化页面等。"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-20">
			<header class="page-head">
				<Hero
					title="作品"
					tagline="按媒介类型组织。每个项目卡片可点入详情，或跳转到完整 case study。"
					align="start"
				/>

				<nav class="cat-nav">
					{grouped.map((g) => (
						<a href={`#${g.slug}`} class="cat-link" data-empty={g.projects.length === 0}>
							{g.label}
							<span class="cat-count">{g.projects.length}</span>
						</a>
					))}
				</nav>
			</header>

			{grouped.map((g) => (
				<section id={g.slug} class="cat-section">
					<header class="cat-header">
						<h2>{g.label}</h2>
						<p class="cat-meta">{g.projects.length} 个项目</p>
					</header>
					{g.projects.length > 0 ? (
						<Grid variant="offset">
							{g.projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))}
						</Grid>
					) : (
						<p class="empty">该分类暂无项目（建设中）。</p>
					)}
				</section>
			))}
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	main.wrapper {
		gap: 4rem;
	}

	.page-head {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin-bottom: 1rem;
	}

	.cat-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.cat-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		border-radius: 999rem;
		border: 1px solid var(--gray-800);
		background: var(--gray-999_40);
		color: var(--gray-200);
		text-decoration: none;
		font-size: var(--text-sm);
		transition: all 0.2s ease;
	}

	.cat-link:hover {
		color: var(--accent-text-over);
		background: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	.cat-link[data-empty='true'] {
		opacity: 0.5;
	}

	.cat-count {
		font-size: var(--text-xs);
		padding: 0.1rem 0.5rem;
		background: var(--gray-800);
		border-radius: 999rem;
		color: var(--gray-300);
	}

	.cat-link:hover .cat-count {
		background: var(--gray-999);
		color: var(--accent-regular);
	}

	.cat-section {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		scroll-margin-top: 5rem;
	}

	.cat-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		border-bottom: 1px solid var(--gray-800);
		padding-bottom: 1.5rem;
	}

	.cat-header h2 {
		font-size: var(--text-2xl);
		color: var(--gray-0);
		margin: 0;
	}

	.cat-meta {
		color: var(--gray-400);
		font-size: var(--text-sm);
		margin: 0;
	}

	.empty {
		color: var(--gray-400);
		font-style: italic;
		padding: 2rem 0;
	}
</style>
