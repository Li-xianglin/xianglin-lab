---
import { getCollection } from 'astro:content';
import { CATEGORIES, type CategorySlug } from '../content.config';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = await getCollection('work');
// Featured grid 只展示设计类作品（排除摄影），摄影留在作品页的独立分类
const featured = all.filter((p) => p.data.featured);
const designOthers = all
	.filter((p) => !p.data.featured && p.data.category !== 'sheying')
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const featuredProjects = [...featured, ...designOthers].slice(0, 4);

const categoryCounts = (Object.keys(CATEGORIES) as CategorySlug[]).map((slug) => {
	const items = all.filter((p) => p.data.category === slug);
	return {
		slug,
		label: CATEGORIES[slug],
		count: items.length,
		// 唯一一项时：直接跳详情；多项时：去 work 页对应锚点；0 项时也去锚点（看到"建设中"提示）
		href: items.length === 1 ? `/work/${items[0].id}/` : `/work/#${slug}`,
	};
});

const skillTags = [
	'B 端设计', 'Design System', '海外 FinTech', '交互设计',
	'产品思维', '视觉设计', '动效设计', '0→1', '组件库',
];

const focusCards = [
	{
		icon: 'terminal-window',
		title: '多业务设计经验',
		desc: '主导从 0 到 1 的信息架构与交互设计，覆盖金融、政务、出行等多业务场景。',
	},
	{
		icon: 'pencil-line',
		title: 'Design System',
		desc: '从 0 搭建组件规范与样式系统，提升设计与研发协作效率与一致性。',
	},
	{
		icon: 'squares-four',
		title: '跨端 / 多端体验',
		desc: '同时驾驭 Portal / App / Miniapp 三端，统一跨端设计语言与组件体系。',
	},
	{
		icon: 'rocket-launch',
		title: '海外 FinTech',
		desc: '为海外金融机构设计 B 端系统与移动 App，获 2024 外资最佳潜力奖。',
	},
];
---

<BaseLayout>
	<div class="home stack">
		{/* HERO */}
		<section class="hero wrapper">
			<div class="hero-bg">
				<svg class="deco-lines" viewBox="0 0 1440 800" preserveAspectRatio="none" aria-hidden="true">
					<path d="M-50 250 Q 600 180 1500 320" stroke="rgba(255,255,255,0.08)" stroke-width="1" fill="none" />
					<path d="M-50 600 Q 700 700 1500 480" stroke="rgba(255,255,255,0.06)" stroke-width="1" fill="none" />
					<line x1="1100" y1="-50" x2="1500" y2="850" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
					<circle cx="1200" cy="180" r="120" stroke="rgba(255,255,255,0.04)" stroke-width="1" fill="none" />
					<circle cx="1200" cy="180" r="200" stroke="rgba(255,255,255,0.025)" stroke-width="1" fill="none" />
				</svg>

				<div class="ghost-text" aria-hidden="true">DESIGN</div>

				<svg class="sparkle sparkle-1" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 0 L13.5 10.5 L24 12 L13.5 13.5 L12 24 L10.5 13.5 L0 12 L10.5 10.5 Z" fill="rgba(255,255,255,0.5)"/>
				</svg>
				<svg class="sparkle sparkle-2" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 0 L13.5 10.5 L24 12 L13.5 13.5 L12 24 L10.5 13.5 L0 12 L10.5 10.5 Z" fill="rgba(255,255,255,0.4)"/>
				</svg>
				<svg class="sparkle sparkle-3" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 0 L13.5 10.5 L24 12 L13.5 13.5 L12 24 L10.5 13.5 L0 12 L10.5 10.5 Z" fill="rgba(255,255,255,0.3)"/>
				</svg>
			</div>

			<p class="eyebrow">UX / UI · DESIGNER · 成都</p>

			<div class="hero-grid">
				<div class="hero-text">
					<h1 class="display">
						<span class="display-line">MAKING</span>
						<span class="display-line display-italic">COMPLEX</span>
						<span class="display-line">EFFORTLESS.</span>
					</h1>

					<div class="hero-meta">
						<p class="hero-name">李想林 / Xianglin Li</p>
						<p class="hero-desc">
							UX/UI 设计师 · 8 年互联网设计经验<br />
							专注 B 端复杂系统的<span class="keep">从 0 到 1</span>与 <span class="keep">Design System</span> 建设
						</p>

						<div class="hero-cta">
							<CallToAction href="/work/">
								查看作品
								<Icon icon="arrow-right" size="1.2em" />
							</CallToAction>
						</div>
					</div>
				</div>

				<div class="hero-art">
					<div class="scroll-indicator" aria-hidden="true">
						<span class="scroll-text">SCROLL DOWN</span>
						<span class="scroll-line"></span>
						<span class="scroll-circle">↓</span>
					</div>
					<div class="portrait-stack">
						<div class="portrait-frame-outline" aria-hidden="true"></div>
						<div class="portrait-wrap">
							<div class="spotlight" aria-hidden="true"></div>
							<img class="portrait" src="/assets/avatar.jpg" alt="李想林" />
						</div>
						<div class="stat stat-1">
							<span class="stat-num">8<small>年</small></span>
							<span class="stat-label">设计经验</span>
						</div>
						<div class="stat stat-2">
							<span class="stat-num">10<small>+</small></span>
							<span class="stat-label">项目</span>
						</div>
						<div class="stat stat-3">
							<span class="stat-num">5</span>
							<span class="stat-label">领域</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		{/* DIAGONAL SKILL RIBBON */}
		<section class="skill-ribbon" aria-hidden="true" data-reveal>
			<div class="skill-ribbon-track">
				{[...skillTags, ...skillTags, ...skillTags].map((tag) => (
					<span class="skill-tag">
						{tag}
						<svg class="ribbon-star" viewBox="0 0 24 24"><path d="M12 0 L13.5 10.5 L24 12 L13.5 13.5 L12 24 L10.5 13.5 L0 12 L10.5 10.5 Z" fill="currentColor"/></svg>
					</span>
				))}
			</div>
		</section>

		{/* FOCUS / EXPERTISE */}
		<section class="wrapper focus">
			<header class="section-head" data-reveal>
				<p class="eyebrow">FOCUS · 专长方向</p>
				<h2 class="section-title">理解业务，驱动体验。</h2>
			</header>
			<div class="focus-grid" data-reveal-stagger>
				{focusCards.map((c) => (
					<article class="focus-card">
						<Icon icon={c.icon as any} color="var(--accent-regular)" size="2.2rem" gradient />
						<h3>{c.title}</h3>
						<p>{c.desc}</p>
					</article>
				))}
			</div>
		</section>

		{/* FEATURED WORK — Bento Grid */}
		<section class="wrapper featured">
			<header class="section-head" data-reveal>
				<p class="eyebrow">SELECTED WORK</p>
				<h2 class="section-title">精选作品</h2>
				<p class="section-desc">近年主导或参与的代表性项目与设计探索。</p>
			</header>
			<div class="featured-grid" data-reveal-stagger>
				{featuredProjects.map((p, i) => (
					<a class={`feat-card feat-card--${i + 1}`} href={`/work/${p.id}/`}>
						<div class="feat-img-wrap">
							<img src={p.data.img} alt={p.data.img_alt || p.data.title} loading="lazy" />
						</div>
						<div class="feat-overlay">
							<div class="feat-top">
								<span class="feat-cat">{CATEGORIES[p.data.category]}</span>
								{p.data.award && <span class="feat-award">★ Award</span>}
							</div>
							<div class="feat-bottom">
								<h3 class="feat-title">{p.data.title}</h3>
								<p class="feat-desc">{p.data.description}</p>
								<span class="feat-arrow" aria-hidden="true">→</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</section>

		{/* CATEGORIES */}
		<section class="wrapper categories">
			<header class="section-head" data-reveal>
				<p class="eyebrow">EXPLORE BY CATEGORY</p>
				<h2 class="section-title">按媒介浏览</h2>
			</header>
			<div class="cat-grid" data-reveal-stagger>
				{categoryCounts.map((c, i) => (
					<a class="cat-card" href={c.href}>
						<span class="cat-num">{String(i + 1).padStart(2, '0')}</span>
						<span class="cat-label">{c.label}</span>
						<span class="cat-count">{c.count} 项</span>
						<Icon icon="arrow-right" size="1.5em" />
					</a>
				))}
			</div>
		</section>

		{/* CTA */}
		<section class="cta-section wrapper" data-reveal>
			<header class="cta-head">
				<p class="eyebrow">GET IN TOUCH</p>
				<h2 class="cta-title">准备好开始合作了吗？</h2>
				<p class="cta-desc">世界属于那些勤于思考的人，更属于那些善于行动的人。</p>
			</header>

			<div class="contact-card">
				<div class="wechat-qr">
					<img src="/wechat-qr.svg" alt="李想林的微信二维码" />
					<p class="wechat-caption">扫码加我微信</p>
				</div>

				<div class="contact-info">
					<div class="contact-row contact-row--static">
						<span class="contact-label">电话</span>
						<span class="contact-value">+86 135 4024 0539</span>
					</div>
					<div class="contact-row contact-row--static">
						<span class="contact-label">邮箱</span>
						<span class="contact-value">2698956635@qq.com</span>
					</div>
					<div class="contact-row contact-row--static">
						<span class="contact-label">坐标</span>
						<span class="contact-value">四川 · 成都</span>
					</div>
				</div>
			</div>
		</section>

		{/* WORDMARK */}
		<section class="wordmark" data-reveal>
			<img src="/xianglin-li-wordmark.svg" alt="Xianglin Li" />
			<p class="wordmark-sub">Designed & built in Chengdu · 2026</p>
		</section>
	</div>

	<script>
		// ===== Entry reveal via IntersectionObserver =====
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						io.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
		);

		document
			.querySelectorAll('[data-reveal], [data-reveal-stagger]')
			.forEach((el) => io.observe(el));

		// ===== Focus card mouse-glow position =====
		document.querySelectorAll('.focus-card').forEach((card) => {
			card.addEventListener('mousemove', (e) => {
				const rect = card.getBoundingClientRect();
				const cx = ((e.clientX - rect.left) / rect.width) * 100;
				const cy = ((e.clientY - rect.top) / rect.height) * 100;
				card.style.setProperty('--cx', cx + '%');
				card.style.setProperty('--cy', cy + '%');
			});
		});
	</script>
</BaseLayout>

<style>
	.home {
		--mark-color: var(--gray-200);
	}

	/* ===== ENTRY REVEAL ANIMATIONS ===== */
	[data-reveal] {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
	}

	[data-reveal].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	[data-reveal-stagger] > * {
		opacity: 0;
		transform: translateY(28px);
		transition:
			opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
	}

	[data-reveal-stagger].is-visible > * {
		opacity: 1;
		transform: translateY(0);
	}

	[data-reveal-stagger].is-visible > *:nth-child(1) { transition-delay: 0s; }
	[data-reveal-stagger].is-visible > *:nth-child(2) { transition-delay: 0.08s; }
	[data-reveal-stagger].is-visible > *:nth-child(3) { transition-delay: 0.16s; }
	[data-reveal-stagger].is-visible > *:nth-child(4) { transition-delay: 0.24s; }
	[data-reveal-stagger].is-visible > *:nth-child(5) { transition-delay: 0.32s; }
	[data-reveal-stagger].is-visible > *:nth-child(6) { transition-delay: 0.40s; }

	@media (prefers-reduced-motion: reduce) {
		[data-reveal],
		[data-reveal-stagger] > * {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}
	}

	.eyebrow {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gray-400);
		margin: 0;
	}

	.section-head {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 3rem;
	}

	.section-title {
		font-family: var(--font-brand);
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--gray-0);
		margin: 0;
	}

	.section-desc {
		color: var(--gray-300);
		max-width: 60ch;
		margin: 0;
	}

	/* ===== HERO ===== */
	.hero {
		position: relative;
		padding-top: 2rem;
		padding-bottom: 4rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		isolation: isolate;
	}

	/* ===== HERO BACKGROUND DECORATIONS ===== */
	.hero-bg {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: -1;
	}

	/* Page-wide dot pattern is defined in BaseLayout.astro (applies to every page) */

	.deco-lines {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}


	.ghost-text {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		font-family: var(--font-brand);
		font-weight: 800;
		font-size: clamp(8rem, 22vw, 20rem);
		line-height: 0.8;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 1px rgba(255, 255, 255, 0.06);
		white-space: nowrap;
		user-select: none;
		mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
		-webkit-mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
	}

	/* ===== PORTRAIT SPOTLIGHT ===== */
	.spotlight {
		position: absolute;
		inset: -30%;
		background: radial-gradient(
			ellipse at center,
			rgba(255, 255, 255, 0.18) 0%,
			rgba(255, 255, 255, 0.06) 30%,
			transparent 65%
		);
		filter: blur(40px);
		pointer-events: none;
		z-index: -1;
		animation: spotlight-pulse 6s ease-in-out infinite;
	}

	@keyframes spotlight-pulse {
		0%, 100% { opacity: 0.6; transform: scale(1); }
		50% { opacity: 1; transform: scale(1.05); }
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		align-items: center;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.hero-meta {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 52ch;
	}

	.display {
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: clamp(2.6rem, 9vw, 7rem);
		line-height: 1;
		letter-spacing: -0.04em;
		color: var(--gray-0);
		margin: 0;
		text-transform: uppercase;
		display: flex;
		flex-direction: column;
		gap: 0.05em;
	}

	.display-line {
		display: block;
		line-height: 1;
	}

	.display-italic {
		font-style: italic;
		font-weight: 500;
		color: var(--gray-999);
		-webkit-text-stroke: 3px var(--gray-100);
		paint-order: stroke fill;
		letter-spacing: -0.02em;
	}

	.hero-name {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		color: var(--gray-200);
		margin: 0;
		letter-spacing: 0.02em;
	}

	.hero-desc {
		color: var(--gray-300);
		max-width: 50ch;
		font-size: var(--text-md);
		margin: 0;
		line-height: 1.7;
		text-wrap: pretty;
	}

	.hero-desc .keep {
		white-space: nowrap;
		color: var(--gray-100);
		font-weight: 500;
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
	}

	.ghost-cta {
		color: var(--gray-200);
		text-decoration: none;
		font-family: var(--font-brand);
		font-weight: 500;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--gray-600);
		transition: all 0.2s ease;
	}

	.ghost-cta:hover {
		color: var(--gray-0);
		border-bottom-color: var(--gray-0);
	}

	/* Hero portrait + floating stats */
	.hero-art {
		justify-self: center;
		max-width: 620px;
		width: 100%;
	}

	.portrait-stack {
		position: relative;
		aspect-ratio: 4 / 6;
		width: 100%;
	}

	.portrait-frame-outline {
		position: absolute;
		inset: -1.5rem -1.5rem 1.5rem 1.5rem;
		border: 1px solid var(--gray-700);
		clip-path: polygon(
			0 48px, 48px 0,
			100% 0,
			100% calc(100% - 48px), calc(100% - 48px) 100%,
			0 100%
		);
		pointer-events: none;
	}

	.portrait-wrap {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: visible;
		background: linear-gradient(135deg, var(--gray-100) 0%, var(--gray-50) 100%);
		clip-path: polygon(
			0 48px, 48px 0,
			100% 0,
			100% calc(100% - 48px), calc(100% - 48px) 100%,
			0 100%
		);
	}

	.portrait {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: contrast(1.05);
	}


	.portrait[src='/avatar.jpg']:not([data-loaded]) {
		/* fallback while image not yet placed */
	}

	.stat {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		padding: 0.7rem 1rem 0.7rem 0.9rem;
		background: var(--gray-999);
		color: var(--gray-0);
		border: 1px solid var(--gray-200);
		box-shadow: var(--shadow-md);
		z-index: 2;
		min-width: 5.5rem;
		clip-path: polygon(
			0 0,
			calc(100% - 12px) 0,
			100% 12px,
			100% 100%,
			0 100%
		);
	}

	.stat-num {
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: var(--text-xl);
		line-height: 1;
	}

	.stat-num small {
		font-size: 0.6em;
		font-weight: 400;
		margin-left: 2px;
	}

	.stat-label {
		font-size: 0.7rem;
		color: var(--gray-300);
		margin-top: 2px;
	}

	.stat-1 {
		top: 2rem;
		left: -1rem;
	}

	.stat-2 {
		top: 50%;
		right: -1.5rem;
		transform: translateY(-50%);
	}

	.stat-3 {
		bottom: 2rem;
		left: 30%;
	}

	@media (min-width: 60em) {
		.hero {
			padding-top: 3rem;
			padding-bottom: 7rem;
		}

		.hero-grid {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
		}

		.stat-1 {
			top: 3rem;
			left: -2rem;
		}

		.stat-2 {
			right: -2.5rem;
		}

		.stat-3 {
			bottom: 3rem;
			left: -1rem;
		}
	}

	/* ===== SPARKLES ===== */
	.sparkle {
		position: absolute;
		width: 18px;
		height: 18px;
		animation: sparkle-twinkle 4s ease-in-out infinite;
	}

	.sparkle-1 {
		top: 12%;
		left: 56%;
		animation-delay: 0s;
	}

	.sparkle-2 {
		top: 38%;
		left: 8%;
		width: 12px;
		height: 12px;
		animation-delay: 1.5s;
	}

	.sparkle-3 {
		top: 78%;
		left: 65%;
		width: 14px;
		height: 14px;
		animation-delay: 2.5s;
	}

	@keyframes sparkle-twinkle {
