---
import { getCollection } from 'astro:content';
import { CATEGORIES, type CategorySlug } from '../content.config';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = await getCollection('work');
const featured = all.filter((p) => p.data.featured);
const others = all
	.filter((p) => !p.data.featured)
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const featuredProjects = [...featured, ...others].slice(0, 4);

const categoryCounts = (Object.keys(CATEGORIES) as CategorySlug[]).map((slug) => ({
	slug,
	label: CATEGORIES[slug],
	count: all.filter((p) => p.data.category === slug).length,
}));

const partners = ['上海择仕', '中信银行', '成都地铁', '智元汇', '拓尔思', '安徽大学'];

const focusCards = [
	{
		icon: 'terminal-window',
		title: 'B 端复杂系统',
		desc: '主导从 0 到 1 的信息架构与交互设计，覆盖金融、政务、出行等多业务场景。',
	},
	{
		icon: 'pencil-line',
		title: 'Design System',
		desc: '从 0 搭建组件规范与样式系统，提升设计与研发协作效率与一致性。',
	},
	{
		icon: 'rocket-launch',
		title: '海外 FinTech',
		desc: '为海外金融机构设计 B 端系统与移动 App，获 2024 外资最佳潜力奖。',
	},
];
---

<BaseLayout>
	<div class="home stack">
		{/* HERO */}
		<section class="hero wrapper">
			<p class="eyebrow">UX / UI · DESIGNER · 上海</p>

			<div class="hero-grid">
				<div class="hero-text stack gap-6">
					<h1 class="display">
						BUILDING<br />
						<span class="display-italic">complex</span><br />
						EXPERIENCES.
					</h1>
					<p class="hero-name">李想林 / Xianglin Li</p>
					<p class="hero-desc">
						UX/UI 设计师 — 7 年互联网设计经验，擅长 B 端复杂系统的从 0 到 1 与 Design System 建设。
					</p>

					<div class="hero-cta">
						<CallToAction href="/work/">
							查看作品
							<Icon icon="arrow-right" size="1.2em" />
						</CallToAction>
						<a class="ghost-cta" href="/about/">关于我 →</a>
					</div>
				</div>

				<div class="hero-art">
					<div class="portrait-wrap">
						<img class="portrait" src="/assets/avatar.jpg" alt="李想林" />
						<div class="stat stat-1">
							<span class="stat-num">7<small>年</small></span>
							<span class="stat-label">设计经验</span>
						</div>
						<div class="stat stat-2">
							<span class="stat-num">{all.length}<small>+</small></span>
							<span class="stat-label">项目</span>
						</div>
						<div class="stat stat-3">
							<span class="stat-num">5</span>
							<span class="stat-label">领域</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		{/* PARTNERS STRIP */}
		<section class="partners">
			<div class="partners-track">
				{[...partners, ...partners].map((p) => (
					<span class="partner-item">{p}</span>
				))}
			</div>
		</section>

		{/* FOCUS / EXPERTISE */}
		<section class="wrapper focus">
			<header class="section-head">
				<p class="eyebrow">EXPERTISE</p>
				<h2 class="section-title">为复杂业务<br />设计清晰的体验。</h2>
			</header>
			<div class="focus-grid">
				{focusCards.map((c) => (
					<article class="focus-card">
						<Icon icon={c.icon as any} color="var(--accent-regular)" size="2.2rem" gradient />
						<h3>{c.title}</h3>
						<p>{c.desc}</p>
					</article>
				))}
			</div>
		</section>

		{/* FEATURED WORK */}
		<section class="wrapper featured">
			<header class="section-head">
				<p class="eyebrow">SELECTED WORK</p>
				<h2 class="section-title">精选作品</h2>
				<p class="section-desc">近年主导/参与的代表性项目，覆盖 B 端后台、移动端、网页与可视化大屏。</p>
			</header>
			<div class="featured-grid">
				{featuredProjects.map((p, i) => (
					<a class={`feat-card ${i === 0 ? 'feat-large' : ''}`} href={`/work/${p.id}/`}>
						<div class="feat-img-wrap">
							<img src={p.data.img} alt={p.data.img_alt || p.data.title} loading="lazy" />
						</div>
						<div class="feat-meta">
							<span class="feat-cat">{CATEGORIES[p.data.category]}</span>
							<h3 class="feat-title">{p.data.title}</h3>
							<p class="feat-desc">{p.data.description}</p>
							{p.data.award && <span class="feat-award">★ {p.data.award}</span>}
						</div>
					</a>
				))}
			</div>
			<div class="featured-cta">
				<CallToAction href="/work/">
					查看全部作品
					<Icon icon="arrow-right" size="1.2em" />
				</CallToAction>
			</div>
		</section>

		{/* CATEGORIES */}
		<section class="wrapper categories">
			<header class="section-head">
				<p class="eyebrow">EXPLORE BY CATEGORY</p>
				<h2 class="section-title">按媒介浏览</h2>
			</header>
			<div class="cat-grid">
				{categoryCounts.map((c, i) => (
					<a class="cat-card" href={`/work/#${c.slug}`}>
						<span class="cat-num">{String(i + 1).padStart(2, '0')}</span>
						<span class="cat-label">{c.label}</span>
						<span class="cat-count">{c.count} 项</span>
						<Icon icon="arrow-right" size="1.5em" />
					</a>
				))}
			</div>
		</section>

		{/* CTA */}
		<section class="cta-section wrapper">
			<h2 class="cta-title">准备好开始合作了吗？</h2>
			<p class="cta-desc">远程协作、自由职业、长期合伙都欢迎。邮箱通常 24 小时内回复。</p>
			<div class="cta-actions">
				<CallToAction href="mailto:2698956635@qq.com">
					给我发邮件
					<Icon icon="paper-plane-tilt" size="1.2em" />
				</CallToAction>
				<a class="ghost-cta" href="https://works.meiye.art/preview/ZDB25216R5810O9A">完整作品集 →</a>
			</div>
		</section>

		{/* WORDMARK */}
		<section class="wordmark">
			<p>XIANGLIN&nbsp;LI</p>
		</section>
	</div>
</BaseLayout>

<style>
	.home {
		--mark-color: var(--gray-200);
	}

	.eyebrow {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gray-400);
		margin: 0;
	}

	.section-head {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 3rem;
	}

	.section-title {
		font-family: var(--font-brand);
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--gray-0);
		margin: 0;
	}

	.section-desc {
		color: var(--gray-300);
		max-width: 60ch;
		margin: 0;
	}

	/* ===== HERO ===== */
	.hero {
		padding-top: 2rem;
		padding-bottom: 4rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		align-items: center;
	}

	.display {
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: clamp(2.6rem, 9vw, 7rem);
		line-height: 0.95;
		letter-spacing: -0.04em;
		color: var(--gray-0);
		margin: 0;
		text-transform: uppercase;
	}

	.display-italic {
		font-style: italic;
		font-weight: 400;
		color: var(--accent-regular);
		text-transform: lowercase;
	}

	.hero-name {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		color: var(--gray-200);
		margin: 0;
		letter-spacing: 0.02em;
	}

	.hero-desc {
		color: var(--gray-300);
		max-width: 38ch;
		font-size: var(--text-md);
		margin: 0;
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
	}

	.ghost-cta {
		color: var(--gray-200);
		text-decoration: none;
		font-family: var(--font-brand);
		font-weight: 500;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--gray-600);
		transition: all 0.2s ease;
	}

	.ghost-cta:hover {
		color: var(--accent-regular);
		border-bottom-color: var(--accent-regular);
	}

	/* Hero portrait + floating stats */
	.hero-art {
		justify-self: center;
		max-width: 480px;
		width: 100%;
	}

	.portrait-wrap {
		position: relative;
		aspect-ratio: 4 / 5;
		border-radius: 1.5rem;
		overflow: visible;
		background:
			linear-gradient(135deg, var(--gray-100) 0%, var(--gray-50) 100%);
	}

	.portrait {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 1.5rem;
		filter: contrast(1.05);
	}

	.portrait[src='/avatar.jpg']:not([data-loaded]) {
		/* fallback while image not yet placed */
	}

	.stat {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1rem;
		background: var(--gray-999);
		color: var(--gray-0);
		border: 1px solid var(--gray-200);
		border-radius: 999rem;
		box-shadow: var(--shadow-md);
		z-index: 2;
		min-width: 5rem;
	}

	.stat-num {
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: var(--text-xl);
		line-height: 1;
	}

	.stat-num small {
		font-size: 0.6em;
		font-weight: 400;
		margin-left: 2px;
	}

	.stat-label {
		font-size: 0.7rem;
		color: var(--gray-300);
		margin-top: 2px;
	}

	.stat-1 {
		top: 2rem;
		left: -1rem;
	}

	.stat-2 {
		top: 50%;
		right: -1.5rem;
		transform: translateY(-50%);
	}

	.stat-3 {
		bottom: 2rem;
		left: 30%;
	}

	@media (min-width: 60em) {
		.hero {
			padding-top: 3rem;
			padding-bottom: 7rem;
		}

		.hero-grid {
			grid-template-columns: 6fr 5fr;
			gap: 5rem;
		}

		.stat-1 {
			top: 3rem;
			left: -2rem;
		}

		.stat-2 {
			right: -2.5rem;
		}

		.stat-3 {
			bottom: 3rem;
			left: -1rem;
		}
	}

	/* ===== PARTNERS STRIP ===== */
	.partners {
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 2rem 0;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
	}

	.partners-track {
		display: flex;
		gap: 4rem;
		animation: marquee 30s linear infinite;
		white-space: nowrap;
		width: max-content;
	}

	.partner-item {
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--text-xl);
		color: var(--gray-300);
		letter-spacing: 0.05em;
		flex: 0 0 auto;
	}

	@keyframes marquee {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	/* ===== FOCUS ===== */
	.focus {
		padding-block: 5rem;
	}

	.focus-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.focus-card {
		padding: 2rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		transition: all 0.3s ease;
	}

	.focus-card:hover {
		border-color: var(--accent-regular);
		transform: translateY(-2px);
	}

	.focus-card h3 {
		font-family: var(--font-brand);
		font-size: var(--text-xl);
		color: var(--gray-0);
		margin: 0;
	}

	.focus-card p {
		color: var(--gray-300);
		margin: 0;
		line-height: 1.6;
	}

	@media (min-width: 60em) {
		.focus-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* ===== FEATURED ===== */
	.featured {
		padding-block: 5rem;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		margin-bottom: 3rem;
	}

	.feat-card {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		background: var(--gray-999_40);
		transition: all 0.3s ease;
	}

	.feat-card:hover {
		border-color: var(--accent-regular);
		transform: translateY(-4px);
	}

	.feat-img-wrap {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--gray-900);
	}

	.feat-img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.feat-card:hover .feat-img-wrap img {
		transform: scale(1.04);
	}

	.feat-meta {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.feat-cat {
		font-size: var(--text-sm);
		color: var(--accent-regular);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.feat-title {
		font-family: var(--font-brand);
		font-size: var(--text-xl);
		color: var(--gray-0);
		margin: 0;
	}

	.feat-desc {
		color: var(--gray-300);
		font-size: var(--text-sm);
		margin: 0;
		line-height: 1.5;
	}

	.feat-award {
		font-size: var(--text-sm);
		color: var(--gray-200);
		margin-top: 0.5rem;
	}

	.featured-cta {
		display: flex;
		justify-content: center;
	}

	@media (min-width: 60em) {
		.featured-grid {
			grid-template-columns: repeat(3, 1fr);
			grid-auto-flow: dense;
		}

		.feat-large {
			grid-column: span 2;
			grid-row: span 2;
		}

		.feat-large .feat-img-wrap {
			aspect-ratio: 16 / 11;
		}

		.feat-large .feat-title {
			font-size: var(--text-2xl);
		}
	}

	/* ===== CATEGORIES ===== */
	.categories {
		padding-block: 5rem;
	}

	.cat-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		border-top: 1px solid var(--gray-800);
	}

	.cat-card {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: center;
		gap: 1.5rem;
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--gray-800);
		text-decoration: none;
		color: var(--gray-0);
		transition: all 0.2s ease;
	}

	.cat-card:hover {
		padding-inline: 1rem;
		background: var(--gray-999_40);
	}

	.cat-num {
		font-family: var(--font-brand);
		font-weight: 600;
		color: var(--gray-400);
		font-size: var(--text-md);
	}

	.cat-label {
		font-family: var(--font-brand);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		color: var(--gray-0);
	}

	.cat-count {
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	/* ===== CTA SECTION ===== */
	.cta-section {
		padding: 6rem 0;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.cta-title {
		font-family: var(--font-brand);
		font-size: clamp(2rem, 6vw, 4rem);
		line-height: 1.05;
		color: var(--gray-0);
		margin: 0;
	}

	.cta-desc {
		color: var(--gray-300);
		max-width: 50ch;
		margin: 0;
	}

	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		align-items: center;
		margin-top: 1rem;
	}

	/* ===== BIG WORDMARK ===== */
	.wordmark {
		padding: 3rem 0 0;
		text-align: center;
		overflow: hidden;
	}

	.wordmark p {
		font-family: var(--font-brand);
		font-weight: 700;
		font-size: clamp(3rem, 18vw, 14rem);
		line-height: 0.9;
		letter-spacing: -0.04em;
		color: transparent;
		-webkit-text-stroke: 1px var(--gray-300);
		margin: 0;
		text-transform: uppercase;
	}
</style>
