---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="zh-CN" class="theme-dark">
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body>
		<div class="page-decor" aria-hidden="true">
			<div class="dot-pattern"></div>
		</div>
		<div class="stack backgrounds">
			<Nav />
			<slot />
		</div>

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));

			// Add 'is-scrolled' class to <html> after the user scrolls 20px
			const handleScroll = () => {
				document.documentElement.classList.toggle('is-scrolled', window.scrollY > 20);
			};
			handleScroll();
			window.addEventListener('scroll', handleScroll, { passive: true });
		</script>

		<style is:global>
			/* High-end B&W theme overrides — no purple, no gradients */
			:root.theme-dark {
				--accent-light: #ffffff;
				--accent-regular: #ffffff;
				--accent-dark: #d4d4d4;
				--accent-overlay: hsla(0, 0%, 100%, 0.08);
				--accent-subtle-overlay: hsla(0, 0%, 100%, 0.05);
				--accent-text-over: #0a0a0a;
				--link-color: #ffffff;

				--gradient-stop-1: #ffffff;
				--gradient-stop-2: #d4d4d4;
				--gradient-stop-3: #888888;
				--gradient-accent: linear-gradient(135deg, #ffffff 0%, #b0b0b0 100%);
				--gradient-accent-orange: linear-gradient(135deg, #f5f5f5 0%, #888888 100%);
				--gradient-subtle: linear-gradient(150deg, #161616 0%, #0a0a0a 100%);
				--gradient-stroke: linear-gradient(180deg, #2a2a2a, #161616);

				/* Tonal grays — smooth black to white scale */
				--gray-0: #ffffff;
				--gray-50: #f5f5f5;
				--gray-100: #e5e5e5;
				--gray-200: #c4c4c4;
				--gray-300: #999999;
				--gray-400: #707070;
				--gray-500: #525252;
				--gray-600: #3a3a3a;
				--gray-700: #2a2a2a;
				--gray-800: #1f1f1f;
				--gray-900: #141414;
				--gray-999-basis: 0, 0%, 4%;
				--gray-999_40: hsla(var(--gray-999-basis), 0.5);
				--gray-999: #0a0a0a;
			}
		</style>
		<style>
			html,
			body {
				background: var(--gray-999);
			}

			.backgrounds {
				min-height: 100%;
				position: relative;
			}

			.backgrounds::before {
				content: '';
				position: fixed;
				inset: 0;
				background:
					radial-gradient(ellipse 80% 50% at 50% 0%, var(--accent-overlay), transparent 70%),
					url('/assets/backgrounds/noise.png') top center/220px repeat;
				background-blend-mode: overlay, normal;
				pointer-events: none;
				z-index: -1;
				opacity: 0.6;
			}

			/* Page-wide dot pattern background (visible on every page) */
			.page-decor {
				position: fixed;
				inset: 0;
				pointer-events: none;
				z-index: 0;
			}

			.page-decor .dot-pattern {
				position: absolute;
				inset: 0;
				background-image: radial-gradient(rgba(255, 255, 255, 0.15) 1.2px, transparent 1.2px);
				background-size: 32px 32px;
			}

			:root:not(.theme-dark) .page-decor .dot-pattern {
				background-image: radial-gradient(rgba(0, 0, 0, 0.12) 1.2px, transparent 1.2px);
			}
		</style>
	</body>
</html>
